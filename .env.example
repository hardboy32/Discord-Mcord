# Required: Discord bot token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Recommended: Application ID from Discord Developer Portal
DISCORD_CLIENT_ID=your_application_id_here

# Optional: test server ID for instant slash-command updates
DISCORD_GUILD_ID=

# Optional: your Discord user ID for /activity ownership checks
BOT_OWNER_ID=

# Optional: warning storage file. If you attach a Railway Volume at /app/data,
# the default path already stores warnings persistently there.
# WARNINGS_FILE=/app/data/warnings.json

# Optional: Groq API key enables AI chat replies
GROQ_API_KEY=

# Optional: defaults to openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# Optional: YouTube OAuth refresh token for account-restricted playback.
# Add the value only in Railway Variables; never commit a real token.
YT_OAUTH_REFRESH_TOKEN=

# Optional: enable routine diagnostic logs while troubleshooting.
DEBUG_LOGS=false

# Optional: also requires the privileged Presence Intent in the Discord Developer Portal.
# Keep false unless you explicitly want member online/offline and activity logs.
ENABLE_PRESENCE_LOGGING=false

# Optional: live stream alert integrations.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Lavalink runs in the same Railway container as the bot. A private password
# is generated automatically at startup when this is left empty.
LAVALINK_PASSWORD=

# Optional: Java maximum heap size for Lavalink (default: 512m).
LAVALINK_JAVA_XMX=512m

# Dashboard: fixed single Discord server
DASHBOARD_GUILD_ID=686002315148394502
DISCORD_CLIENT_SECRET=
DASHBOARD_SESSION_SECRET=generate_a_long_random_secret
DASHBOARD_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN/auth/callback

# Mcord bot (required for the combined deployment)
MCORD_BOT_TOKEN=

# Optional Mcord audio settings
# Set either token or both. Add both to run Mcord and Discord together.
# Optional YouTube authentication for the direct fallback.
# Never commit the cookies file itself to GitHub.
# YOUTUBE_COOKIES_B64=...
# Optional direct YouTube fallback settings.
# Multiple proxies may be comma-separated; one is chosen per request/run.
# YOUTUBE_PROXY=http://user:password@host:port,http://user2:password@host:port
# YOUTUBE_USER_AGENT=Mozilla/5.0 ...
# YTDLP_PLAYER_CLIENTS=android_vr,web_embedded
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
